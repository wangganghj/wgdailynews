TIMEZONE=America/Vancouver
UPDATE_HOUR=8
UPDATE_MINUTE=0

# Translation Provider (google | gemini | openai | deepl)
TRANSLATION_PROVIDER=google

# Gemini API (Recommended for Translation & Daily AI Briefing)
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI API
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# DeepL API
# DEEPL_API_KEY=your-deepl-key

# AI Daily News Briefing
ENABLE_AI_BRIEFING=true

# Push Notifications (Telegram & Webhooks)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-100123456789
# WEBHOOK_URL=https://discord.com/api/webhooks/... (or Feishu/WeCom webhook)
